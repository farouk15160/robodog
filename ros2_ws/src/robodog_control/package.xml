<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robodog_control</name>
  <version>0.1.0</version>
  <description>
    Control stack for the robodog quadruped: leg kinematics, safety monitor,
    gait generation, joint test motions, floating-base state estimation and the
    single real-time control node. Backend-agnostic by construction.
  </description>
  <maintainer email="farouk15160@gmail.com">farouk</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>robodog_msgs</depend>
  <depend>robodog_hardware</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>robodog_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
