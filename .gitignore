# ROS 2 / colcon
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Documentation build products. The .drawio sources are tracked; the PDFs and
# generated_facts.tex are regenerated by `cd docs && make`.
docs/*.aux
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz

# Generated model artefacts. Regenerate with:
#   python3 tools/cad_to_model.py && python3 tools/prepare_meshes.py
#   ros2 run robodog_sim generate_models
# They are committed here so the workspace builds without the CAD toolchain;
# delete these lines if you would rather treat them as pure build products.
