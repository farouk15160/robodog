<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="robodog" modified="" agent="tools/make_diagrams.py"><diagram id="perception_pipeline" name="RGB-D perception and mapping"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="cfg" value="nuwa_hp60c.yaml&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;range + noise + normal-mode sizes;&#10;real calibration remains device-specific&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="270" height="80" as="geometry" /></mxCell><mxCell id="simb" value="SimCameraBackend&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;MuJoCo RGB-D render;&#10;K derived from rendered FOV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#5b8def;fontColor=#14305e;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="30" width="270" height="80" as="geometry" /></mxCell><mxCell id="realb" value="NuwaHP60CBackend&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;RGB capture only today;&#10;depth / hardware odometry unavailable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8d6;strokeColor=#f0894e;fontColor=#5c2c10;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="270" height="90" as="geometry" /></mxCell><mxCell id="frame" value="Registered simulation Frame&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;mapping: RGB + depth 640 x 480&#10;same origin, K and acquisition stamp&#10;RGB uint8; internal depth float32 m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="270" height="100" as="geometry" /></mxCell><mxCell id="node" value="robodog_camera_node&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;15 Hz; depth -&amp;gt; 16UC1 millimetres&#10;0 depth means invalid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="260" height="100" as="geometry" /></mxCell><mxCell id="topics" value="ROS camera outputs&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;color/image_raw + camera_info&#10;depth/image_rect_raw + camera_info&#10;depth/points (PointCloud2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#e0a800;fontColor=#4a3600;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="260" height="110" as="geometry" /></mxCell><mxCell id="optical" value="Simulation camera frame&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;RGB, depth and point cloud all use&#10;camera_color_optical_frame&#10;&#10;optical: z forward, x right, y down&#10;&#10;No depth-frame baseline is applied&#10;to the co-located simulated images.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="270" height="190" as="geometry" /></mxCell><mxCell id="policy" value="mapping:=auto (default)&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;RTAB-Map on: MuJoCo + sim camera + use_camera:=true&#10;Off for unsupported backends / cameras; mapping:=none disables&#10;Explicit mapping:=rtabmap rejects unsupported pipelines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="340" width="580" height="110" as="geometry" /></mxCell><mxCell id="odom" value="Control node owns odometry&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;odom -&amp;gt; base_link&#10;MuJoCo ground truth; wall timestamps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="290" height="90" as="geometry" /></mxCell><mxCell id="map" value="RTAB-Map + built-in OctoMap&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;exact RGB-D synchronization, 2 Hz&#10;5 cm cells; 4 m depth range&#10;owns map -&amp;gt; odom&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="520" width="290" height="110" as="geometry" /></mxCell><mxCell id="rviz" value="Mapping RViz view&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;map: 2D occupancy grid&#10;octomap_occupied_space: 3D cells&#10;robot + world markers in map frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b7cf6;fontColor=#2e2159;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="520" width="350" height="110" as="geometry" /></mxCell><mxCell id="store" value="Timestamped session database&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;$ROS_HOME/robodog/maps/&#10;&amp;lt;world&amp;gt;-&amp;lt;UTC timestamp&amp;gt;.db&#10;explicit path resumes a saved session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="390" y="710" width="290" height="105" as="geometry" /></mxCell><mxCell id="export" value="Backup and export&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;rtabmap/backup: database .back&#10;octomap_saver_node: full ColorOcTree .ot&#10;No separate mapping server required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="710" width="350" height="105" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="cfg" target="simb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="simb" target="frame"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="frame" target="node"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="node" target="topics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="topics" target="map"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="odom" target="map"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="map" target="rviz"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="map" target="store"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="store" target="export"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>