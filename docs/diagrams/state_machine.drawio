<mxfile host="robodog" modified="" agent="tools/make_diagrams.py"><diagram id="state_machine" name="Robot state machine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="620" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="init" value="INIT&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;backend configuring&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="180" height="70" as="geometry" /></mxCell><mxCell id="idle" value="IDLE&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;powered, joints off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="180" height="70" as="geometry" /></mxCell><mxCell id="ready" value="READY&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;enabled, holding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="540" y="60" width="180" height="70" as="geometry" /></mxCell><mxCell id="stand" value="STANDING&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;pose reached&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="180" height="70" as="geometry" /></mxCell><mxCell id="move" value="MOVING&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;gait active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="180" height="70" as="geometry" /></mxCell><mxCell id="fault" value="FAULT&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;limit exceeded&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#e05252;fontColor=#5a1d1d;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="830" y="200" width="190" height="70" as="geometry" /></mxCell><mxCell id="estop" value="E-STOP&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;output inhibited, latched&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#e05252;fontColor=#5a1d1d;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="830" y="340" width="190" height="70" as="geometry" /></mxCell><mxCell id="n1" value="Transitions out of E-STOP&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;clear_estop succeeds only when no&#10;hardware-protective fault is still true:&#10;over-temperature, over-current,&#10;under-voltage, encoder, communication.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="400" height="120" as="geometry" /></mxCell><mxCell id="n2" value="Latching faults&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;A silently stale joint is the failure mode&#10;most likely to break a leg, so a&#10;communication timeout latches rather&#10;than degrading quietly.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="400" height="130" as="geometry" /></mxCell><mxCell id="e0" value="backend ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="init" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="enable_joints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="idle" target="ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="set_named_pose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="ready" target="stand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="set_gait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="stand" target="move"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="gait: stand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="move" target="stand"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="disable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="ready" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="limit exceeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="stand" target="fault"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="protective fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="fault" target="estop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="operator STOP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="move" target="estop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="clear_estop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="estop" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>