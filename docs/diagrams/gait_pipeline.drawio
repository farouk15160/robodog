<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="robodog" modified="" agent="tools/make_diagrams.py"><diagram id="gait_pipeline" name="Gait generator: one control cycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="stc" value="STANCE  -  the foot is fixed in the world" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="540" height="214" as="geometry" /></mxCell><mxCell id="swc" value="SWING  -  interpolate two latched ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="350" width="540" height="214" as="geometry" /></mxCell><mxCell id="out" value="GaitOutput" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1100" height="104" as="geometry" /></mxCell><mxCell id="cmd" value="cmd_vel -&amp;gt; GaitParams&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;vx, vy, wz, gait,&#10;frequency, duty&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="62" as="geometry" /></mxCell><mxCell id="cfg" value="gaits.yaml&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;offsets, duty, step height,&#10;stance height&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="40" width="280" height="62" as="geometry" /></mxCell><mxCell id="fb" value="BodyFeedback&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;height, vz, roll, pitch, omega, v_xy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="460" height="62" as="geometry" /></mxCell><mxCell id="phase" value="Phase clock&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;phi += f dt  (mod 1)&#10;phi_i = (phi + offset_i) mod 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="68" as="geometry" /></mxCell><mxCell id="raib" value="Raibert foot placement&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;p = v_meas T/2 + k_v (v_meas - v*)&#10;clamped to max_placement_m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="460" height="68" as="geometry" /></mxCell><mxCell id="sel" value="Per leg:  phi_i &amp;lt; duty ?&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;stance : swing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="400" height="52" as="geometry" /></mxCell><mxCell id="st1" value="Touchdown&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;resume from the LAST COMMANDED position&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="62" y="394" width="496" height="48" as="geometry" /></mxCell><mxCell id="st2" value="Retract&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;p -= (v_meas + g_sweep (v* - v_meas)) dt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="62" y="452" width="496" height="48" as="geometry" /></mxCell><mxCell id="st3" value="Settle&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;decay touchdown_depth over the first 1/6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="62" y="510" width="496" height="48" as="geometry" /></mxCell><mxCell id="sw1" value="Lift-off&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;latch p0 = where stance actually left the foot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="622" y="394" width="496" height="48" as="geometry" /></mxCell><mxCell id="sw2" value="Land&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;p1 tracks Raibert through the swing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="622" y="452" width="496" height="48" as="geometry" /></mxCell><mxCell id="sw3" value="Arc&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;p0 + (p1-p0) sigma(u),   z += h sin^2(pi u)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="622" y="510" width="496" height="48" as="geometry" /></mxCell><mxCell id="ik" value="Leg IK + Jacobian&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;q = IK(p),   qd = J^+ v&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="540" height="62" as="geometry" /></mxCell><mxCell id="bal" value="Balance&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;wrench -&amp;gt; per-foot force -&amp;gt; tau = -J^T f&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="600" width="540" height="62" as="geometry" /></mxCell><mxCell id="outk" value="Joint targets&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;q[12]   qd[12]   foot_target[4]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="62" y="730" width="496" height="50" as="geometry" /></mxCell><mxCell id="outf" value="Forces and schedule&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;tau_ff[12]   foot_force[4]   contact[4]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="622" y="730" width="496" height="50" as="geometry" /></mxCell><mxCell id="note" value="Continuity is the invariant: neither transition may step.&#10;Rebuilding the swing arc from the nominal foot position instead cost 41 mm per lift-off, and stopped the robot walking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="1100" height="62" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="cmd" target="phase"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="cfg" target="phase"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="fb" target="raib"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="phase" target="sel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="sel" target="st1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="sel" target="sw1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="raib" target="sw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="sw1" target="sw2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="sw2" target="sw3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="st3" target="ik"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="sw3" target="bal"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="ik" target="outk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="bal" target="outf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="body state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="fb" target="bal"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>