<mxfile host="robodog" modified="" agent="tools/make_diagrams.py"><diagram id="control_architecture" name="Control architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="790" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="l4" value="LAYER 4  BEHAVIOUR&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;on demand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1060" height="110" as="geometry" /></mxCell><mxCell id="l3" value="LAYER 3  GAIT AND POSE&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;400 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1060" height="110" as="geometry" /></mxCell><mxCell id="l2" value="LAYER 2  SAFETY&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;400 Hz, every cycle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="1060" height="110" as="geometry" /></mxCell><mxCell id="l1" value="LAYER 1  JOINT INTERFACE&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;400 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1060" height="110" as="geometry" /></mxCell><mxCell id="l0" value="LAYER 0  ACTUATOR&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;firmware, tens of kHz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#8fa6bf;fontColor=#26333f;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1060" height="170" as="geometry" /></mxCell><mxCell id="op" value="Operator / autonomy&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;cmd_vel, gait, named pose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="300" height="55" as="geometry" /></mxCell><mxCell id="traj" value="Trajectory&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;minimum jerk, speed limited&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="300" height="55" as="geometry" /></mxCell><mxCell id="test" value="Joint test&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;sine / sweep / step / sequential&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="320" height="55" as="geometry" /></mxCell><mxCell id="gait" value="Gait generator&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;phase, duty, swing / stance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="330" height="55" as="geometry" /></mxCell><mxCell id="ik" value="Leg IK + Jacobian&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;closed form, knee-back branch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="280" height="55" as="geometry" /></mxCell><mxCell id="ff" value="Balance&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;body wrench -&amp;gt; per-foot force,&#10;friction-cone projected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="750" y="210" width="310" height="55" as="geometry" /></mxCell><mxCell id="lim" value="Position / velocity&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;soft limits + rate limit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="250" height="55" as="geometry" /></mxCell><mxCell id="tq" value="Torque + I2t&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;predict, scale kp/kd/tau&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="250" height="55" as="geometry" /></mxCell><mxCell id="th" value="Thermal&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;warn / derate / fault&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="200" height="55" as="geometry" /></mxCell><mxCell id="wd" value="Watchdog + E-stop&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;latching&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="870" y="350" width="190" height="55" as="geometry" /></mxCell><mxCell id="be" value="JointBackend.write(JointCommand)&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;position, velocity, effort, kp, kd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="450" height="55" as="geometry" /></mxCell><mxCell id="st" value="JointBackend.read() -&amp;gt; JointState&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;position, velocity, effort, temperature, faults&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#3ecf8e;fontColor=#0f3f2c;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="500" height="55" as="geometry" /></mxCell><mxCell id="can" value="CAN motion-control frame&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;1 command per joint per cycle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8d6;strokeColor=#f0894e;fontColor=#5c2c10;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="300" height="55" as="geometry" /></mxCell><mxCell id="foc" value="RS02 impedance law + FOC&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;tau = kp(q*-q) + kd(qd*-qd) + tau_ff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8d6;strokeColor=#f0894e;fontColor=#5c2c10;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="410" y="630" width="340" height="55" as="geometry" /></mxCell><mxCell id="enc" value="2 x 14-bit encoders&lt;br/&gt;&lt;font style='font-size:10px;opacity:0.75'&gt;3.8e-4 rad output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe8d6;strokeColor=#f0894e;fontColor=#5c2c10;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="780" y="630" width="280" height="55" as="geometry" /></mxCell><mxCell id="note" value="The host sets SETPOINTS at 400 Hz; the servo loop is closed in the actuator. This is why 400 Hz is not a compromise." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c8d0da;fontColor=#5a6675;fontFamily=Helvetica;fontSize=12;arcSize=8;verticalAlign=middle;align=center;spacing=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="980" height="42" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="op" target="gait"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="traj" target="ik"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="test" target="ff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="gait" target="lim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="ik" target="tq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="ff" target="th"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="lim" target="be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="tq" target="be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="th" target="be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="wd" target="st"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#3b82f6;" edge="1" parent="1" source="be" target="can"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="can" target="foc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;" edge="1" parent="1" source="foc" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;fontColor=#4a5568;strokeColor=#7a8899;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#3b82f6;" edge="1" parent="1" source="enc" target="st"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>